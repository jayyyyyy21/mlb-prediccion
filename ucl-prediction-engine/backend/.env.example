# Base de datos: PostgreSQL en producción. Si se omite se usa SQLite local (data/ucl.db).
DATABASE_URL=postgresql+psycopg2://ucl:ucl@localhost:5432/ucl

# API-Football (api-sports.io) — OPCIONAL. Necesaria para lesiones y suspensiones verificadas.
# Sin esta clave la app muestra "Bajas: no verificadas" y reduce la confianza del pronóstico.
API_FOOTBALL_KEY=

# Token para los endpoints de administración (POST /api/admin/refresh)
ADMIN_TOKEN=cambia-esto

# Minutos entre actualizaciones automáticas (alineaciones / clima / cuotas). 0 = desactivado.
REFRESH_INTERVAL_MIN=30

# Temporada de Champions a seguir (año de inicio) y desde qué mes cargar histórico.
UCL_SEASON_START=2026
HISTORY_FROM=2024-08
